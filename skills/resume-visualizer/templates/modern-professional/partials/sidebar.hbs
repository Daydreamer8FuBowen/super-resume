<!-- Photo -->
{{#if personal_info.photo}}
<div class="sidebar-photo">
  <img src="{{personal_info.photo}}" alt="{{personal_info.full_name}}" />
</div>
{{else}}
<div class="sidebar-photo sidebar-photo-placeholder">
  <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor">
    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v1.2c0 .66.54 1.2 1.2 1.2h16.8c.66 0 1.2-.54 1.2-1.2v-1.2c0-3.2-6.4-4.8-9.6-4.8z"/>
  </svg>
</div>
{{/if}}

<!-- Contact -->
<div class="sidebar-section">
  <h3 class="sidebar-title">Contact</h3>
  <ul class="contact-list">
    {{#if personal_info.email}}
    <li>
      <svg class="contact-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
      <a href="mailto:{{personal_info.email}}">{{personal_info.email}}</a>
    </li>
    {{/if}}
    {{#if personal_info.phone}}
    <li>
      <svg class="contact-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
      {{personal_info.phone}}
    </li>
    {{/if}}
    {{#if personal_info.location}}
    <li>
      <svg class="contact-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
      {{personal_info.location}}
    </li>
    {{/if}}
  </ul>
</div>

<!-- Links -->
{{#if personal_info.links}}
<div class="sidebar-section">
  <h3 class="sidebar-title">Links</h3>
  <ul class="contact-list">
    {{#if personal_info.links.github}}
    <li><a href="{{personal_info.links.github}}" target="_blank">GitHub</a></li>
    {{/if}}
    {{#if personal_info.links.linkedin}}
    <li><a href="{{personal_info.links.linkedin}}" target="_blank">LinkedIn</a></li>
    {{/if}}
    {{#if personal_info.links.portfolio}}
    <li><a href="{{personal_info.links.portfolio}}" target="_blank">Portfolio</a></li>
    {{/if}}
    {{#if personal_info.links.website}}
    <li><a href="{{personal_info.links.website}}" target="_blank">Website</a></li>
    {{/if}}
    {{#each personal_info.links.other}}
    <li><a href="{{this}}" target="_blank">{{this}}</a></li>
    {{/each}}
  </ul>
</div>
{{/if}}

<!-- Skills (compact sidebar version) -->
{{#if skills}}
<div class="sidebar-section">
  <h3 class="sidebar-title">Skills</h3>
  {{#if skills.programming_languages}}
  <div class="sidebar-skill-group">
    <span class="sidebar-skill-label">Languages</span>
    <span class="sidebar-skill-text">{{join skills.programming_languages ", "}}</span>
  </div>
  {{/if}}
  {{#if skills.frameworks}}
  <div class="sidebar-skill-group">
    <span class="sidebar-skill-label">Frameworks</span>
    <span class="sidebar-skill-text">{{join skills.frameworks ", "}}</span>
  </div>
  {{/if}}
  {{#if skills.databases}}
  <div class="sidebar-skill-group">
    <span class="sidebar-skill-label">Databases</span>
    <span class="sidebar-skill-text">{{join skills.databases ", "}}</span>
  </div>
  {{/if}}
  {{#if skills.tools}}
  <div class="sidebar-skill-group">
    <span class="sidebar-skill-label">Tools</span>
    <span class="sidebar-skill-text">{{join skills.tools ", "}}</span>
  </div>
  {{/if}}
  {{#if skills.platforms}}
  <div class="sidebar-skill-group">
    <span class="sidebar-skill-label">Platforms</span>
    <span class="sidebar-skill-text">{{join skills.platforms ", "}}</span>
  </div>
  {{/if}}
</div>
{{/if}}

<!-- Languages -->
{{#if languages}}
<div class="sidebar-section">
  <h3 class="sidebar-title">Languages</h3>
  <ul class="simple-list">
  {{#each languages}}
    <li><strong>{{language}}</strong>{{#if proficiency}} — {{proficiency}}{{/if}}</li>
  {{/each}}
  </ul>
</div>
{{/if}}

<!-- Education (compact sidebar version) -->
{{#if education}}
<div class="sidebar-section">
  <h3 class="sidebar-title">Education</h3>
  {{#each education}}
  <div class="sidebar-edu-item">
    <div class="sidebar-edu-degree">{{#if degree}}{{degree}}{{/if}}{{#if major}} in {{major}}{{/if}}</div>
    <div class="sidebar-edu-school">{{#if school}}{{school}}{{/if}}{{#if location}}, {{location}}{{/if}}</div>
    <div class="sidebar-edu-dates">
      {{#if start_date}}{{start_date}}{{/if}}{{#if end_date}} – {{end_date}}{{/if}}
    </div>
    {{#if gpa}}<div class="sidebar-edu-gpa">GPA {{gpa}}</div>{{/if}}
  </div>
  {{/each}}
</div>
{{/if}}
