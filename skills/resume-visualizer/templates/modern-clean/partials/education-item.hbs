<div class="education-item entry">
  <div class="entry-header">
    <span class="entry-title">{{#if degree}}{{degree}}{{/if}}{{#if major}} in {{major}}{{/if}}</span>
    <span class="entry-dates">
      {{#if start_date}}{{start_date}}{{/if}}
      {{#if end_date}} – {{end_date}}{{/if}}
    </span>
  </div>
  <div class="entry-subheader">
    {{#if school}}{{school}}{{/if}}
    {{#if location}}<span class="location"> · {{location}}</span>{{/if}}
    {{#if gpa}}<span class="location"> · GPA {{gpa}}</span>{{/if}}
  </div>
  {{#if honors}}
  <ul class="entry-bullets" style="margin-top:2px;">
    {{#each honors}}
    <li>{{this}}</li>
    {{/each}}
  </ul>
  {{/if}}
</div>
