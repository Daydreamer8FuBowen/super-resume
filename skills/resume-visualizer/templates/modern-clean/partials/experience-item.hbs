<div class="entry">
  <div class="entry-header">
    <span class="entry-title">{{#if role}}{{role}}{{/if}}{{#if company}}{{#if role}} at {{/if}}{{company}}{{/if}}</span>
    <span class="entry-dates">
      {{#if start_date}}{{start_date}}{{/if}}
      {{#if end_date}} – {{end_date}}{{/if}}
      {{#if is_current}} – Present{{/if}}
    </span>
  </div>
  {{#if location}}
  <div class="entry-subheader">
    {{#if employment_type}}{{employment_type}}{{/if}}
    {{#if location}}<span class="location"> · {{location}}</span>{{/if}}
  </div>
  {{/if}}
  {{#if achievements}}
  <ul class="entry-bullets">
    {{#each achievements}}
    <li>
      {{#if claim}}{{claim}}{{/if}}
      {{#if metric}} — <strong>{{metric}}</strong>{{/if}}
      {{#if technologies}}
      <div class="entry-tech">{{join technologies ", "}}</div>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if responsibilities}}
  <ul class="entry-bullets">
    {{#each responsibilities}}
    <li>{{this}}</li>
    {{/each}}
  </ul>
  {{/if}}
</div>
