<div class="entry entry-project">
  <div class="entry-header">
    <span class="entry-title">{{#if name}}{{name}}{{/if}}</span>
    <span class="entry-dates">
      {{#if start_date}}{{start_date}}{{/if}}
      {{#if end_date}} – {{end_date}}{{/if}}
    </span>
  </div>
  <div class="entry-subheader">
    {{#if role}}{{role}}{{/if}}
    {{#if type}}<span class="location"> · {{type}}</span>{{/if}}
  </div>
  {{#if problem}}
  <ul class="entry-bullets">
    <li>{{problem}}</li>
  </ul>
  {{/if}}
  {{#if actions}}
  <ul class="entry-bullets">
    {{#each actions}}
    <li>{{this}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if results}}
  <ul class="entry-bullets">
    {{#each results}}
    <li><strong>Result:</strong> {{this}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if technologies}}
  <div class="entry-tech">{{join technologies ", "}}</div>
  {{/if}}
  {{#if links}}
  <div class="entry-tech" style="margin-top:1px;">
    {{#each links}}
    <a href="{{this}}" target="_blank" style="color:var(--color-accent);">{{this}}</a>{{#unless @last}} · {{/unless}}
    {{/each}}
  </div>
  {{/if}}
</div>
